{
  "permissions": {
    "allow": [
      "Bash(source ~/.zshrc 2>/dev/null; curl -s \"https://api.trello.com/*)",
      "Bash(curl -s \"https://api.trello.com/*)",
      "mcp__trello__trello_get_recent_activity",
      "mcp__trello__trello_get_my_cards",
      "mcp__trello__trello_get_card",
      "mcp__trello__trello_get_cards_by_list",
      "mcp__trello__trello_get_lists",
      "mcp__trello__trello_search_all_boards",
      "mcp__trello__trello_get_card_attachments"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
